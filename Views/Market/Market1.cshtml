<!-- ===== 前端即時搜尋腳本 ===== -->
<script>
    function filterVendors() {
        const input = document.getElementById('vendorSearchInput');
        const filter = input.value.toLowerCase().trim();
        const clearBtn = document.getElementById('searchClearBtn');
        const sections = document.querySelectorAll('.category-section');
        const noResults = document.getElementById('noResults');
        const searchKeywordText = document.getElementById('searchKeywordText');

        // 控制清除按鈕顯隱
        clearBtn.style.display = filter.length > 0 ? 'block' : 'none';

        let totalVisibleCount = 0;

        sections.forEach(section => {
            const categoryTitle = section.querySelector('.category-title').textContent.toLowerCase();
            const cards = section.querySelectorAll('.vendor-card');
            let visibleCardsInSection = 0;

            cards.forEach(card => {
                const vendorText = card.textContent.toLowerCase();

                // 如果關鍵字包含在攤販文字中，或是包含在該分類標題中
                if (vendorText.includes(filter) || categoryTitle.includes(filter)) {
                    card.style.display = '';
                    visibleCardsInSection++;
                    totalVisibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // 若整個分類區塊下沒有任何符合的卡片，隱藏整個分類區塊
            if (visibleCardsInSection > 0) {
                section.style.display = '';
            } else {
                section.style.display = 'none';
            }
        });

        // 如果全部沒找到，顯示「無結果」提示
        if (totalVisibleCount === 0 && filter.length > 0) {
            searchKeywordText.textContent = input.value;
            noResults.style.display = 'block';
        } else {
            noResults.style.display = 'none';
        }
    }

    function clearSearch() {
        const input = document.getElementById('vendorSearchInput');
        input.value = '';
        filterVendors();
        input.focus();
    }
</script>
