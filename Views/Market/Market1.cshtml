<style>
    /* 容器與標題樣式 */
    .vendor-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 15px;
    }

    /* 頂部區域：彈性排版以支援搜尋框放右上 */
    .page-header-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap; /* 支援手機端自動換行 */
        gap: 15px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 2rem;
        color: #2c3e50;
    }

    /* ===== 橫向滑動圖片輪播 (Banner Slider) ===== */
    .banner-slider-container {
        width: 100%;
        margin-bottom: 35px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        display: flex;
        gap: 15px;
        padding-bottom: 10px; /* 給滾動條留白 */
        -webkit-overflow-scrolling: touch; /* 提升iOS滑動順暢度 */
    }

        /* 隱藏預設滾動條 (可選，保持畫面乾淨) */
        .banner-slider-container::-webkit-scrollbar {
            height: 6px;
        }

        .banner-slider-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

    .banner-item {
        flex: 0 0 85%; /* 手機版露出一點下一張 */
        max-width: 800px;
        height: 260px;
        scroll-snap-align: center;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }

        .banner-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .banner-item:hover img {
            transform: scale(1.03);
        }

    .banner-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 20px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 600;
    }

    /* 搜尋框樣式 */
    .search-box-wrapper {
        width: 100%;
        max-width: 350px;
        margin: 0;
        position: relative;
    }

    .search-input {
        width: 100%;
        padding: 10px 40px 10px 16px;
        font-size: 0.95rem;
        border: 2px solid #e2e8f0;
        border-radius: 25px;
        outline: none;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

        .search-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
        }

    .search-clear-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        font-size: 1.1rem;
        color: #94a3b8;
        cursor: pointer;
        display: none;
        padding: 0;
        line-height: 1;
    }

        .search-clear-btn:hover {
            color: #64748b;
        }

    /* 無搜尋結果提示 */
    .no-results {
        display: none;
        text-align: center;
        padding: 40px 20px;
        color: #64748b;
        font-size: 1.1rem;
        background: #f8fafc;
        border-radius: 12px;
        margin-top: 20px;
    }

    /* 類別標題與網格 */
    .category-section {
        margin-bottom: 35px;
    }

    .category-title {
        color: #2c3e50;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 8px;
        margin-top: 0;
        margin-bottom: 20px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    /* 卡片網格系統 */
    .vendor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
    }

    .vendor-card {
        background: #ffffff;
        border: 1px solid #eef2f5;
        border-radius: 10px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .vendor-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
        }

        .vendor-card h5 {
            margin: 0 0 12px 0;
            font-size: 1rem;
            font-weight: 600;
            color: #333;
            line-height: 1.4;
        }

    /* 日期標籤 Badge */
    .date-badge {
        display: inline-block;
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 12px;
        background-color: #e3f2fd;
        color: #1976d2;
        font-weight: bold;
        margin-left: 6px;
        vertical-align: middle;
    }

    /* 社群按鈕樣式 */
    .social-links {
        display: flex;
        gap: 8px;
    }

    .vendor-btn-bg {
        background-size: cover; /* 圖片等比例填滿按鈕 */
        background-position: center; /* 圖片置中 */
        border: none; /* 邊框開關 */
        color: #ffffff !important; /* 文字顏色 */
        font-weight: bold; /* 文字加粗 */
        text-shadow: 0 2px 4px rgba(0,0,0,0.6); /* 文字陰影，防止背景圖干擾閱讀 */
        padding: 50px 50px; /* 增加按鈕上下高度 */
        position: relative;
        overflow: hidden;
        transition: transform 0.2s ease, filter 0.2s ease;
    }

        .vendor-btn-bg:hover {
            filter: brightness(1.1); /* 滑鼠懸停時微亮 */
            transform: translateY(-2px);
        }

    .btn-social {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 14px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        color: #fff !important;
        transition: opacity 0.2s ease;
    }

        .btn-social:hover {
            opacity: 0.85;
            text-decoration: none;
        }

    .btn-fb {
        background-color: #1877f2;
    }

    .btn-ig {
        background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    }

    .btn-threads {
        background-color: #000000;
    }

    /* 手機端響應式調整 */
    @@media (max-width: 600px) {
        .page-header-wrapper {
            flex-direction: column;
            align-items: flex-start;
        }

        .search-box-wrapper {
            max-width: 100%;
        }

        .banner-item {
            flex: 0 0 92%;
            height: 180px;
        }
    }
</style>

